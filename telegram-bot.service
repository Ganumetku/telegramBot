[Unit]
Description=Telegram Deals Scraper Bot Daemon (24/7)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/TelegramBot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/TelegramBot/.env
ExecStart=/opt/TelegramBot/venv/bin/python3 main.py
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

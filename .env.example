# --- TELEGRAM BOT CREDENTIALS ---
# Token from @BotFather (e.g. 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Private channel where raw deals are pushed for manual review (with @ prefix or -100 ID)
TELEGRAM_PRIVATE_REVIEW_CHANNEL=@YOUR_PRIVATE_REVIEW_CHANNEL_HERE

# Public channel where you manually post approved affiliate links
TELEGRAM_PUBLIC_DEALS_CHANNEL=@YOUR_PUBLIC_DEALS_CHANNEL_HERE

# --- SCRAPING THRESHOLDS & SETTINGS ---
# Minimum discount percentage to trigger an alert (default 80.0%)
DROP_PERCENT=80.0

# Minimum sale price in INR to filter out junk/broken listings (default 99)
MIN_SALE_PRICE=99

# Default comma-separated search keywords to monitor (fallback)
KEYWORDS=men tshirt, men jeans, men shirt, track pants, sneakers, men casual shoes, hoodie, sweatshirt, men jacket, women kurti, kurta set, women top, earbuds, smartwatch

# Platform-specific keywords (comma-separated; fallback to KEYWORDS if empty)
KEYWORDS_MYNTRA=men tshirt, men jeans, men shirt, track pants, sneakers, men casual shoes, hoodie, sweatshirt, men jacket, women kurti, kurta set, women top, women jeans, saree, sandals, sports shoes, men shorts, women dress
KEYWORDS_FLIPKART=men tshirt, men jeans, sneakers, hoodie, sweatshirt, men jacket, women kurti, kurta set, women top, slides, men watch, backpack
KEYWORDS_AMAZON=hoodie, men tshirt, earbuds, smartwatch, phone cover, bedsheet, power bank

# Max keywords to query per platform in a single scan cycle (default 2)
MAX_KEYWORDS_PER_SCAN=2

# Maximum Telegram deals to post per scan cycle (rate-limit protection)
MAX_DEALS_PER_SCAN=3

# Random delay range in seconds between page requests
REQUEST_DELAY_MIN=5.0
REQUEST_DELAY_MAX=15.0

# --- SCAN INTERVALS PER PLATFORM (in minutes) ---
MYNTRA_INTERVAL_MIN=15
FLIPKART_INTERVAL_MIN=30
AMAZON_INTERVAL_MIN=60

# --- PERSISTENT DATA FILE (Anchored to project BASE_DIR) ---
DUPLICATE_DB_FILE=posted_deals.json

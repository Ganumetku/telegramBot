# --- TELEGRAM BOT CREDENTIALS ---
# Token from @BotFather (e.g. 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Private channel where raw deals are pushed for manual review (with @ prefix or -100 ID)
TELEGRAM_PRIVATE_REVIEW_CHANNEL=@YOUR_PRIVATE_REVIEW_CHANNEL_HERE

# Public channel where you manually post approved affiliate links
TELEGRAM_PUBLIC_DEALS_CHANNEL=@YOUR_PUBLIC_DEALS_CHANNEL_HERE

# --- SCRAPING THRESHOLDS & SETTINGS ---
# Minimum discount percentage to trigger an alert (default 80.0%)
DROP_PERCENT=80.0

# Minimum sale price in INR to filter out junk/broken listings (default 99)
MIN_SALE_PRICE=99

# Default comma-separated search keywords to monitor (Girls/Women Categories ordered by importance)
# 1. Ethnic wear (100%): kurta sets, sarees, women tops, women kurti, women dress, bra
# 2. Beauty & skincare (90%): sunscreen spf 50, face serum, moisturizer, lipstick, kajal
# 3. Fashion jewellery (80%): earrings, necklace set, bangles, oxidised jewellery
# 4. Footwear (70%): women flats, sandals, women heels, women sneakers
# 5. Handbags (65%): sling bags, tote bags, handbags
# 6. Hair care & personal care (60%): shampoo, hair oil, hair accessories
# 7. Watches (45%): women watch, women smartwatch
# 8. Home & kitchen (40%): bedsheet, home decor, kitchen organizer
KEYWORDS=kurta set, saree, silk saree, cotton saree, women top, women kurti, women dress, bra, sunscreen spf 50, face serum, moisturizer, lipstick, kajal, earrings, necklace set, bangles, oxidised jewellery, women flats, sandals, women heels, women sneakers, sling bags, tote bags, handbags, shampoo, hair oil, hair accessories, women watch, bedsheet, home decor, kitchen organizer

# Platform-specific keywords (comma-separated; fallback to KEYWORDS if empty)
KEYWORDS_MYNTRA=kurta-sets, sarees, women-tops, women-dresses, bra, sunscreen, face-serum, moisturizer, lipstick, kajal, earrings, jewellery-set, bangles, oxidised-jewellery, flats, sandals, heels, women-sneakers, handbags, sling-bags, tote-bags, shampoo, hair-oil, hair-accessories, women-watches, bedsheets, home-decor
KEYWORDS_FLIPKART=kurta set, saree, silk saree, women top, women kurti, women dress, bra, sunscreen spf 50, face serum, moisturizer, lipstick, kajal, earrings, necklace set, bangles, oxidised jewellery, women flats, sandals, women heels, women sneakers, sling bags, tote bags, handbags, shampoo, hair oil, hair accessories, women watch, bedsheet, home decor, kitchen organizer
KEYWORDS_AMAZON=kurta set for women, saree for women, women tops, women dress, bra for women, sunscreen spf 50, face serum, moisturizer for women, lipstick, kajal, earrings for women, necklace set for women, bangles for women, oxidised jewellery, flats for women, sandals for women, heels for women, sneakers for women, sling bags for women, tote bags for women, handbags for women, shampoo for women, hair oil, hair accessories for women, women watch, bedsheet, home decor, kitchen organizer

# Max keywords to query per platform in a single scan cycle (default 2)
MAX_KEYWORDS_PER_SCAN=2

# Maximum Telegram deals to post per scan cycle (rate-limit protection)
MAX_DEALS_PER_SCAN=3

# Random delay range in seconds between page requests
REQUEST_DELAY_MIN=5.0
REQUEST_DELAY_MAX=15.0

# --- SCAN INTERVALS PER PLATFORM (in minutes) ---
MYNTRA_INTERVAL_MIN=15
FLIPKART_INTERVAL_MIN=30
AMAZON_INTERVAL_MIN=60

# --- PERSISTENT DATA FILE (Anchored to project BASE_DIR) ---
DUPLICATE_DB_FILE=posted_deals.json
